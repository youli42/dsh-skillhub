{
  "name": "@aa2246740/dsh-skillhub",
  "version": "1.0.7",
  "publishConfig": {
    "access": "public"
  },
  "description": "DSH manager for user Skills already on disk in Agent home and DSH home",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aa2246740/dsh-skillhub.git"
  },
  "homepage": "https://github.com/aa2246740/dsh-skillhub#readme",
  "bugs": {
    "url": "https://github.com/aa2246740/dsh-skillhub/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "skills",
    "mcp",
    "cordis"
  ],
  "type": "module",
  "main": "lib/dsh-skillhub.js",
  "types": "lib/types/dsh-skillhub.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test tests/*.test.mjs",
    "prepack": "node scripts/check-package.mjs"
  },
  "exports": {
    ".": {
      "types": "./lib/types/dsh-skillhub.d.ts",
      "default": "./lib/dsh-skillhub.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "entry": "./lib/client.js",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib/*.js",
    "lib/types/**/*.d.ts",
    "scripts/check-package.mjs",
    "cordis.patch.yml",
    "cordis.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-client-connection": ">=0.2.0-rc.1 <0.2.1",
    "@deepseek-ai/dsh-client-locale": ">=0.2.0-rc.1 <0.2.1",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.2.0-rc.1 <0.2.1",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.0-rc.1 <0.2.1",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.0-rc.1 <0.2.1",
    "@deepseek-ai/dsh-client-ui-session": ">=0.2.0-rc.1 <0.2.1",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.2.0-rc.1 <0.2.1",
    "@deepseek-ai/dsh-client-ui-settings-general": ">=0.2.0-rc.1 <0.2.1",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.0-rc.1 <0.2.1",
    "@deepseek-ai/dsh-host-webserver": ">=0.2.0-rc.1 <0.2.1",
    "@deepseek-ai/dsh-mcp-client": ">=0.2.0-rc.1 <0.2.1",
    "@deepseek-ai/dsh-scope": ">=0.2.0-rc.1 <0.2.1",
    "@deepseek-ai/dsh-settings": ">=0.2.0-rc.1 <0.2.1",
    "@deepseek-ai/dsh-skill": ">=0.2.0-rc.1 <0.2.1",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-client-connection": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-settings-general": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.2.0-rc.2",
    "@deepseek-ai/dsh-mcp-client": "0.2.0-rc.2",
    "@deepseek-ai/dsh-scope": "0.2.0-rc.2",
    "@deepseek-ai/dsh-settings": "0.2.0-rc.2",
    "@deepseek-ai/dsh-skill": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "3.18.4",
    "@types/node": "^24.3.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "jsdom": "^30.1.1",
    "lightningcss": "^1.32.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "semver": "^7.7.2",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "unrun": "^0.3.1"
  }
}
